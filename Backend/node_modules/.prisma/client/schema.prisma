generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model ChucVu {
  MaChucVu  Int        @id @default(autoincrement())
  TenChucVu String
  nhanViens NhanVien[]
}

model ChiNhanh {
  MaChiNhanh  Int        @id @default(autoincrement())
  TenChiNhanh String
  DiaChi      String
  DienThoai   String
  nhanViens   NhanVien[]
}

model NhanVien {
  MaNhanVien      Int              @id @default(autoincrement())
  TenNhanVien     String
  MaChucVu        Int
  chucVu          ChucVu           @relation(fields: [MaChucVu], references: [MaChucVu])
  MaChiNhanh      Int
  chiNhanh        ChiNhanh         @relation(fields: [MaChiNhanh], references: [MaChiNhanh])
  NgaySinh        DateTime?
  GioiTinh        String?
  DiaChi          String?
  DienThoai       String?
  account         Account?
  phieuNhaps      PhieuNhap[]
  phieuXuats      PhieuXuat[]
  yeuCauNhapHangs YeuCauNhapHang[]
}

model Account {
  MaNhanVien Int      @id
  nhanVien   NhanVien @relation(fields: [MaNhanVien], references: [MaNhanVien])
  UserName   String   @unique
  PassWord   String
  Role       String   @default("USER")
}

model KhachHang {
  MaKhachHang   Int         @id @default(autoincrement())
  TenKhach      String
  Email         String      @unique
  MatKhau       String
  DiaChi        String?
  DienThoai     String?
  HangThanhVien String?
  phieuXuats    PhieuXuat[]
}

model LoaiHang {
  MaLoaiHang  Int       @id @default(autoincrement())
  TenLoaiHang String
  sanPhams    SanPham[]
}

model Kho {
  MaKho      Int         @id @default(autoincrement())
  TenKho     String
  DiaChi     String
  sanPhams   SanPham[]
  phieuNhaps PhieuNhap[]
  phieuXuats PhieuXuat[]
}

model NhaCungCap {
  MaNCC      Int         @id @default(autoincrement())
  TenNCC     String
  DiaChi     String?
  DienThoai  String?
  sanPhams   SanPham[]
  phieuNhaps PhieuNhap[]
}

model SanPham {
  MaSanPham       Int              @id @default(autoincrement())
  TenSanPham      String
  MaLoaiHang      Int
  loaiHang        LoaiHang         @relation(fields: [MaLoaiHang], references: [MaLoaiHang])
  SoLuong         Int              @default(0)
  DonGiaNhap      Float
  DonGiaBan       Float
  Anh             String?
  GhiChu          String?
  MaKho           Int
  kho             Kho              @relation(fields: [MaKho], references: [MaKho])
  MaNCC           Int
  nhaCungCap      NhaCungCap       @relation(fields: [MaNCC], references: [MaNCC])
  yeuCauNhapHangs YeuCauNhapHang[]
  ctPhieuNhaps    CTPhieuNhap[]
  ctPhieuXuats    CTPhieuXuat[]
}

model YeuCauNhapHang {
  MaNhanVien Int
  ThoiGian   DateTime @default(now())
  MaSanPham  Int
  nhanVien   NhanVien @relation(fields: [MaNhanVien], references: [MaNhanVien])
  sanPham    SanPham  @relation(fields: [MaSanPham], references: [MaSanPham])

  @@id([MaNhanVien, MaSanPham, ThoiGian])
}

model PhieuNhap {
  MaPhieuNhap  Int           @id @default(autoincrement())
  MaNhanVien   Int
  nhanVien     NhanVien      @relation(fields: [MaNhanVien], references: [MaNhanVien])
  NgayNhap     DateTime      @default(now())
  MaNCC        Int
  nhaCungCap   NhaCungCap    @relation(fields: [MaNCC], references: [MaNCC])
  TongTien     Float
  MaKho        Int
  kho          Kho           @relation(fields: [MaKho], references: [MaKho])
  ctPhieuNhaps CTPhieuNhap[]
}

model CTPhieuNhap {
  STT         Int       @id @default(autoincrement())
  MaPhieuNhap Int
  phieuNhap   PhieuNhap @relation(fields: [MaPhieuNhap], references: [MaPhieuNhap], onDelete: NoAction, onUpdate: NoAction)
  MaSanPham   Int
  sanPham     SanPham   @relation(fields: [MaSanPham], references: [MaSanPham], onDelete: NoAction, onUpdate: NoAction)
  SoLuong     Int
  DonGiaNhap  Float
  GiamGia     Float     @default(0)
  ThanhTien   Float
}

model PhieuXuat {
  MaPhieuXuat  Int           @id @default(autoincrement())
  MaNhanVien   Int
  nhanVien     NhanVien      @relation(fields: [MaNhanVien], references: [MaNhanVien])
  NgayXuat     DateTime      @default(now())
  MaKhachHang  Int
  khachHang    KhachHang     @relation(fields: [MaKhachHang], references: [MaKhachHang])
  TongTien     Float
  MaKho        Int
  kho          Kho           @relation(fields: [MaKho], references: [MaKho])
  TrangThai    String        @default("PENDING")
  ctPhieuXuats CTPhieuXuat[]
}

model CTPhieuXuat {
  STT         Int       @id @default(autoincrement())
  MaPhieuXuat Int
  phieuXuat   PhieuXuat @relation(fields: [MaPhieuXuat], references: [MaPhieuXuat], onDelete: NoAction, onUpdate: NoAction)
  MaSanPham   Int
  sanPham     SanPham   @relation(fields: [MaSanPham], references: [MaSanPham], onDelete: NoAction, onUpdate: NoAction)
  SoLuong     Int
  DonGiaBan   Float
  GiamGia     Float     @default(0)
  ThanhTien   Float
}

// Additional models for web
model BaiViet {
  MaBaiViet Int      @id @default(autoincrement())
  TieuDe    String
  MoTa      String
  Anh       String
  TheLoai   String // "news" or "trend"
  NgayTao   DateTime @default(now())
}

model LienHe {
  MaLienHe Int      @id @default(autoincrement())
  HoTen    String
  Email    String
  NoiDung  String
  NgayTao  DateTime @default(now())
}
